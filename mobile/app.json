{
  "expo": {
    "name": "RumboU",
    "slug": "rumbou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rumbou.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.rumbou.mobile"
    },
    "scheme": "rumbou",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RumboU usa Face ID para que entres sin escribir tu contraseña."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "RumboU usa la cámara para fotografiar tu solución escrita a mano y que el tutor la revise.",
          "photosPermission": "RumboU abre tus fotos para que elijas la foto de tu solución.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RumboU usa el micrófono para que le hagas preguntas al asistente con tu voz."
        }
      ]
    ]
  }
}
