{
  "expo": {
    "name": "RumboU",
    "slug": "rumbou",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rumbou.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.rumbou.mobile",
      "versionCode": 2
    },
    "scheme": "rumbou",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RumboU usa Face ID para que entres sin escribir tu contraseña."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "RumboU usa la cámara para fotografiar tu procedimiento y compararlo con la resolución.",
          "photosPermission": "RumboU abre tus fotos para que elijas la foto de tu procedimiento.",
          "microphonePermission": "RumboU usa el micrófono para que grabes tu explicación de una pregunta."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RumboU usa el micrófono para que grabes tu explicación de una pregunta."
        }
      ]
    ],
    "owner": "rumbou",
    "extra": {
      "eas": {
        "projectId": "7bd9af25-e597-41fb-9fd6-6265a5257f45"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7bd9af25-e597-41fb-9fd6-6265a5257f45"
    }
  }
}
